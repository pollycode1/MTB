<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/widget_root"
    android:background="#F7F3EA"
    android:padding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="LEDGER"
            android:textColor="#7A5A1B" android:textSize="15sp" android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="ใช้วันนี้"
            android:textColor="#7A5A1B" android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="bottom">

        <TextView
            android:id="@+id/widget_spent"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="฿0"
            android:textColor="#20291F" android:textSize="56sp" android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_remaining"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="เหลือในงบสัปดาห์ ฿2500"
            android:textColor="#B98A2E" android:textSize="17sp"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="0" />

</LinearLayout>
